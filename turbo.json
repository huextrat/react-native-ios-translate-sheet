{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build:android": {
      "env": ["ORG_GRADLE_PROJECT_newArchEnabled"],
      "passThroughEnv": ["ANDROID_HOME", "ANDROID_SDK_ROOT", "JAVA_HOME"],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/android/**",
        "!$TURBO_ROOT$/android/build/**",
        "$TURBO_ROOT$/src/*.ts",
        "$TURBO_ROOT$/src/*.tsx",
        "package.json",
        "android/**",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": ["RCT_NEW_ARCH_ENABLED"],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/ios/**",
        "$TURBO_ROOT$/src/*.ts",
        "$TURBO_ROOT$/src/*.tsx",
        "package.json",
        "ios/**",
        "!ios/build/**",
        "!ios/Pods/**"
      ],
      "outputs": []
    }
  }
}
